SALVADOR_HOST=127.0.0.1
SALVADOR_PORT=8000
SALVADOR_LOG_LEVEL=INFO
SALVADOR_TRANSCRIBER_BACKEND=fake
SALVADOR_AUDIO_TARGET_SAMPLE_RATE=24000
SALVADOR_AUDIO_FRAME_DURATION_MS=20
SALVADOR_MAX_AUDIO_MESSAGE_BYTES=65536
# Independent per-channel drop-new queue; rejected frames are recorded as gaps.
SALVADOR_AUDIO_QUEUE_LIMIT=100
SALVADOR_RECONNECT_MAX_ATTEMPTS=5
SALVADOR_RECONNECT_BACKOFF_SECONDS=0.1
SALVADOR_RECONNECT_MAX_BACKOFF_SECONDS=2
SALVADOR_RECONNECT_JITTER_SECONDS=0.05
SALVADOR_RECONNECT_CONNECT_TIMEOUT_SECONDS=10
SALVADOR_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=2
SALVADOR_SHUTDOWN_FINAL_GRACE_SECONDS=0.2
SALVADOR_SHUTDOWN_EXPORT_DRAIN_TIMEOUT_SECONDS=2
SALVADOR_METRICS_ENABLED=true
# Demo/live-runner only. Never enable on an unauthenticated production deployment.
SALVADOR_DEMO_PROVIDER_FAULTS_ENABLED=false

# Real mode fails fast when the key is absent; it never falls back to fake.
SALVADOR_OPENAI_API_KEY=
# Verified with the configured server-VAD profile; an explicit override remains supported.
SALVADOR_OPENAI_MODEL=gpt-4o-transcribe
SALVADOR_OPENAI_TRANSCRIPTION_LANGUAGE=ru
# Server VAD: 700 ms avoids splitting ordinary short pauses by default.
SALVADOR_OPENAI_VAD_THRESHOLD=0.5
SALVADOR_OPENAI_VAD_PREFIX_PADDING_MS=300
SALVADOR_OPENAI_VAD_SILENCE_DURATION_MS=700
SALVADOR_OPENAI_CONNECT_TIMEOUT_SECONDS=10

# Durable final transcript; partial revisions are never stored as finals.
SALVADOR_SQLITE_PATH=var/salvador-transcriber.db
SALVADOR_SQLITE_BUSY_TIMEOUT_MS=5000
# Bounded blocking submission preserves durability of every accepted write.
SALVADOR_SQLITE_QUEUE_LIMIT=1000

# Disabled by default. Set an endpoint before enabling the finite-attempt HTTP exporter.
SALVADOR_EXPORTER_ENABLED=false
# On overflow the durable final remains stored and export_status becomes failed.
SALVADOR_EXPORTER_QUEUE_LIMIT=1000
# SALVADOR_EXPORTER_ENDPOINT=http://127.0.0.1:9000/events
SALVADOR_EXPORTER_TIMEOUT_SECONDS=5
SALVADOR_EXPORTER_MAX_ATTEMPTS=3
SALVADOR_EXPORTER_BACKOFF_SECONDS=0.1
SALVADOR_EXPORTER_JITTER_SECONDS=0.05
